# No secrets belong in source control. Configure these in Render's Environment page.
# Local start defaults to SQLite and loopback, requiring no variables.

# Existing DB_0801 in My Workspace / Singapore; use its Internal URL on Render.
LABELCHECK_DATABASE_URL=postgresql://USER:PASSWORD@HOST/db_0801

# On Render this MUST point beneath an attached persistent disk mount.
# Photos and originals stay on disk; DB_0801 stores indexes and reference-photo associations.
LABELCHECK_DATA_DIR=/var/data/labelcheck
LABELCHECK_HOST=0.0.0.0
LABELCHECK_PASSWORD=replace-with-a-private-password-of-at-least-8-characters
# Separate management code, at least 8 characters, different from LABELCHECK_PASSWORD.
# If missing/invalid, normal scanning works but management access stays locked.
LABELCHECK_ADMIN_PASSWORD=replace-with-a-different-private-management-code
LABELCHECK_SECRET=replace-with-a-random-session-secret
LABELCHECK_HTTPS=1
PORT=10000

# OCR budgets are selected from the actual service/ancestor memory limit.
# Leave unset for automatic policy: 2 GiB -> worker 1280 MiB, reserve 256 MiB.
# Optional conservative overrides; cannot exceed the capacity safety policy.
# LABELCHECK_OCR_WORKER_MB=1024
# LABELCHECK_OCR_RESERVE_MB=256

# Optional paid cloud OCR. Defaults to cloud when a key and website permission exist.
# Otherwise it defaults to local. Users can choose local and sticker-only/full-photo scope.
# Reading the page/config does not call the model or consume trial slots.
# A failed scan never automatically switches between paid cloud and local OCR.
# Set the real key only in the server environment (Render Environment), never in source/UI/DB.
# Leave unset to keep cloud OCR unavailable. Do not commit a real API key here.
# OPENAI_API_KEY=
# LABELCHECK_CLOUD_MODEL=gpt-6.1-sol

# Persistent cumulative trial-call cap, shared by this database; NOT monthly/API USD credits.
# Reserved failed/timed-out/unknown-billing calls also count; redeploy/restart does not reset it.
# One API request per cloud job; no automatic retries, model fallback, or top-up.
# Duplicate request replay does not create another call; an explicit new retry consumes a slot.
# -1 opens cloud usage without the website call cap; provider credits/rate limits still apply.
# 0 disables new cloud calls. Default 20; positive values cap cumulative calls (1-1000).
# Usage records remain preserved in every mode; changing this value does not reset usage.
LABELCHECK_CLOUD_TRIAL_LIMIT=20

# Optional request bounds; defaults shown. Higher limits can increase cost/latency.
# Max image long edge: 256-4096 pixels. Output tokens include reasoning: 512-16384.
# Timeout: 10-180 seconds. A timeout may still be billed by the API provider.
# LABELCHECK_CLOUD_MAX_SIDE=2400
# LABELCHECK_CLOUD_MAX_OUTPUT_TOKENS=8192
# LABELCHECK_CLOUD_TIMEOUT=90
# Offline/mock coverage is not live acceptance: validate paid API/photo flow after deployment.
