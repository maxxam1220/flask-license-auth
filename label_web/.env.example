# No secrets belong in source control. Configure these in Render's Environment page.
# Local start defaults to SQLite and loopback, requiring no variables.

# Existing DB_0801 in My Workspace / Singapore; use its Internal URL on Render.
LABELCHECK_DATABASE_URL=postgresql://USER:PASSWORD@HOST/db_0801

# On Render this MUST point beneath an attached persistent disk mount.
LABELCHECK_DATA_DIR=/var/data/labelcheck
LABELCHECK_HOST=0.0.0.0
LABELCHECK_PASSWORD=replace-with-a-private-password-of-at-least-8-characters
LABELCHECK_SECRET=replace-with-a-random-session-secret
LABELCHECK_HTTPS=1
PORT=10000

# OCR budgets are selected from the actual service/ancestor memory limit.
# Leave unset for automatic policy: 2 GiB -> worker 1280 MiB, reserve 256 MiB.
# Optional conservative overrides; cannot exceed the capacity safety policy.
# LABELCHECK_OCR_WORKER_MB=1024
# LABELCHECK_OCR_RESERVE_MB=256
