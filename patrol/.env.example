# Documentation only: the launcher does not automatically load this file.
# PowerShell: $env:APP_ENV = 'development'
# Render: set variables in the service's Environment settings.

APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:5087
DEMO_MODE=false
IMPORT_SAFETY_POINTS=0
# Compressed photo storage quota (200 MiB), shared across all patrol records.
PHOTO_STORAGE_LIMIT_BYTES=209715200
# Due dates before this Taipei date never count as missed patrols.
# Attendance records, QR links and trial check-ins remain available.
MISSED_START_DATE=2026-11-16

# Local development uses SQLite by default. For PostgreSQL, supply a real
# connection string through the environment. Never commit credentials.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Required in production; use a unique randomly generated secret.
# Render generates this value when using render.yaml.
# SECRET_KEY=

# APP_ENV=production requires PostgreSQL and an HTTPS PUBLIC_BASE_URL.
# Production cookies are Secure; do not disable this for public deployment.
